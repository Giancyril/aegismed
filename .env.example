# Medical Image Analysis Pipeline Configuration
ENVIRONMENT=development

# Storage Configuration
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
NIFTI_DIR=storage/nifti
MASKS_DIR=storage/masks

# Database (Postgres or SQLite fallback)
DATABASE_URL=sqlite:///./medical_metadata.db
# DATABASE_URL=postgresql://medical_user:medical_password@localhost:5432/medical_imaging_db

# S3 / MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=medical-imaging

# Security & API
MEDICAL_API_KEY=clin-demo-key-2026

# Serverless GPU / Model Serving
MODAL_SERVING_URL=https://your-modal-app.modal.run
USE_MOCK_INFERENCE_IF_NO_GPU=true
